# Локальная разработка сервера: скопировать в .env и заполнить
DATABASE_URL=postgres://user:password@localhost:5432/avesto
ADMIN_PASSWORD=change-me
PORT=3000
# Соль для хеширования посетителей в счётчике (openssl rand -hex 32).
# Без неё генерится случайная при старте — счёт уникальных рвётся на каждом
# деплое. Менять после запуска нельзя: старые хеши перестанут совпадать
VISIT_SALT=
